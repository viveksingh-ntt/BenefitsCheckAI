{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Your plan covers this service. Open Benefits in the portal for details.",
  "body": [
    {
      "type": "TextBlock",
      "text": "${service.name}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true,
      "style": "heading"
    },
    {
      "type": "TextBlock",
      "text": "${service.category} · ${plan.name} · ${plan.year} benefits",
      "isSubtle": true,
      "size": "Small",
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "Badge",
      "text": "${coverage.label}",
      "style": "Good",
      "spacing": "Small",
      "fallback": {
        "type": "TextBlock",
        "text": "${coverage.label}",
        "color": "Good",
        "weight": "Bolder",
        "size": "Small",
        "wrap": true
      }
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {
          "$data": "${facts}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "${notice}",
          "size": "Small",
          "wrap": true,
          "isSubtle": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Find this service",
      "verb": "service.find",
      "style": "positive",
      "data": {
        "serviceRef": "${service.ref}"
      }
    },
    {
      "type": "Action.Execute",
      "title": "View plan details",
      "verb": "plan.details",
      "associatedInputs": "none",
      "data": {
        "keepActive": true,
        "planRef": "${plan.ref}"
      }
    }
  ]
}