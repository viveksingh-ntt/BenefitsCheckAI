{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "${title}",
  "body": [
    {
      "type": "Badge",
      "text": "${status}",
      "style": "Good",
      "spacing": "Small",
      "fallback": {
        "type": "TextBlock",
        "text": "${status}",
        "color": "Good",
        "weight": "Bolder",
        "size": "Small",
        "wrap": true
      }
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true,
      "style": "heading"
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {
          "$data": "${facts}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "${notice}",
          "size": "Small",
          "wrap": true,
          "isSubtle": true
        }
      ]
    }
  ]
}