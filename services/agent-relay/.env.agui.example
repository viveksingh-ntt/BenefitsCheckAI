# --- AG-UI host (host_agui.py). Same relay settings as .env.example, minus the Bot Service ones.
BROKER_URL=http://localhost:8102
BROKER_KEY=dev-relay-key                      # Azure: BROKER_RESOURCE=api://healthgen-identity-broker
MCP_URL=http://localhost:8103
MCP_CARDS_KEY=dev-relay-cards-key             # Azure: MCP_CARDS_RESOURCE=api://healthgen-mcp
FOUNDRY_BASE_URL=http://localhost:8105/api/projects/healthgen
FOUNDRY_KEY=dev-foundry-key                   # Azure: FOUNDRY_RESOURCE=api://healthgen-agent-gateway
FOUNDRY_AGENT_NAME=healthgen-triage

# Chat-token verification (the broker signs AG-UI chat tokens)
BROKER_ISSUER=http://localhost:8102
BROKER_JWKS_URL=http://localhost:8102/.well-known/jwks.json
AGUI_TOKEN_AUDIENCE=healthgen-agui

# Browser origins allowed to call /agui/* (the portals)
AGUI_CORS_ORIGINS=http://localhost:8080
