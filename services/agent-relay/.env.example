# --- M365 Agents SDK: the Azure Bot's Entra app (user-assigned managed identity recommended)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot app / MI client id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant id>
# For a single-tenant app with a secret instead:
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=ClientSecret
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<secret from Key Vault>

# --- HealthGen services
BROKER_URL=http://localhost:8102
BROKER_KEY=dev-relay-key                      # Azure: BROKER_RESOURCE=api://healthgen-identity-broker
MCP_URL=http://localhost:8103
MCP_CARDS_KEY=dev-relay-cards-key             # Azure: MCP_CARDS_RESOURCE=api://healthgen-mcp

# --- Foundry through APIM
FOUNDRY_BASE_URL=http://localhost:8105/api/projects/healthgen   # Azure: https://<apim>.azure-api.net/foundry/api/projects/<project>
FOUNDRY_KEY=dev-foundry-key                   # Azure: FOUNDRY_RESOURCE=api://healthgen-agent-gateway (APIM validates it)
# APIM_SUBSCRIPTION_KEY=<optional, if the APIM product requires one>
FOUNDRY_AGENT_NAME=healthgen-triage
# FOUNDRY_AGENT_VERSION=3
FOUNDRY_TIMEOUT_SECONDS=120

# AZURE_CLIENT_ID=<relay user-assigned MI client id, for the *_RESOURCE token calls>

# --- dev_server.py only
DIRECTLINE_SECRET=local-dev-secret
DEV_CORS_ORIGINS=http://localhost:8080
