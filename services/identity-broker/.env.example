# Public base URL of this broker; used as the JWT issuer
BROKER_ISSUER=http://localhost:8102
# Signing: Azure Key Vault key (HSM-backed in production) ...
# BROKER_KEYVAULT_KEY_ID=https://kv-healthgen.vault.azure.net/keys/broker-signing/<version>
# AZURE_CLIENT_ID=<user-assigned managed identity client id>
# ... or a local PEM for dev (omit both to generate an ephemeral key)
# BROKER_SIGNING_KEY_FILE=./dev-keys/broker.pem

# Direct Line (Azure Bot Service channel secret; local dev uses the relay's Direct Line emulator)
DIRECTLINE_SECRET=local-dev-secret
DIRECTLINE_ENDPOINT=http://localhost:8104
DIRECTLINE_TRUSTED_ORIGINS=http://localhost:8080

# Portal assertions (portal BFF signs a <=10 minute JWT for the signed-in user)
PORTAL_ISSUERS=http://localhost:8080
PORTAL_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Service-to-service auth: "entra" in Azure, "keys" for local dev only
SERVICE_AUTH=keys
SERVICE_KEYS=agent-relay=dev-relay-key,mcp-healthgen=dev-mcp-key,apim=dev-apim-key
# SERVICE_AUTH=entra
# ENTRA_TENANT_ID=<tenant id>
# BROKER_ENTRA_AUDIENCES=api://healthgen-identity-broker
# SERVICE_CLIENTS=agent-relay=<relay MI client id>,mcp-healthgen=<mcp MI client id>,apim=<apim MI client id>

# SQLite path (single replica for the pilot)
BROKER_DB_PATH=/tmp/broker.db
SESSION_IDLE_SECONDS=3600
SESSION_MAX_SECONDS=43200
USER_CONTEXT_AUDIENCE=healthgen-agent-gateway
