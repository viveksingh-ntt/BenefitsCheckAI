BROKER_URL=http://localhost:8102
CORE_URL=http://localhost:8101
# How this server authenticates to the broker: dev key, or managed identity for the broker's Entra app
BROKER_CLIENT_KEY=dev-mcp-key
# BROKER_ENTRA_RESOURCE=api://healthgen-identity-broker
# AZURE_CLIENT_ID=<user-assigned MI client id>

# Who may call /mcp. Azure: Entra tokens from the Foundry project's managed identity (or APIM)
MCP_AUTH=keys
MCP_KEYS=foundry=dev-foundry-key
# MCP_AUTH=entra
# ENTRA_TENANT_ID=<tenant id>
# MCP_AUDIENCES=api://healthgen-mcp
# MCP_CLIENTS=foundry=<Foundry project MI client id>,apim=<APIM MI client id>
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Who may read cards (the agent relay)
INTERNAL_AUTH=keys
INTERNAL_KEYS=agent-relay=dev-relay-cards-key
# INTERNAL_AUTH=entra
# INTERNAL_AUDIENCES=api://healthgen-mcp
# INTERNAL_CLIENTS=agent-relay=<relay MI client id>

# n8n hand-off webhook
HANDOFF_WEBHOOK_URL=http://localhost:5678/webhook/healthgen-handoff
HANDOFF_WEBHOOK_SECRET=dev-handoff-secret
